# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Canonical site URL for Open Graph / social previews.
# Production example:
VITE_APP_URL="https://dikshagarwal.site"
APP_URL="https://dikshagarwal.site"

# --- Contact form delivery (configure at least one on Vercel) ---
# 1) Preferred: Resend (https://resend.com)
RESEND_API_KEY=""
CONTACT_TO_EMAIL="dikshaagarwal798@gmail.com"
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# 2) Formspree (https://formspree.io)
FORMSPREE_ID=""
VITE_FORMSPREE_ID=""

# 3) Web3Forms (https://web3forms.com) — client-side key is OK
VITE_WEB3FORMS_ACCESS_KEY=""

# Fallback chain when nothing is configured:
# /api/contact → FormSubmit → visitor mailto compose window.
