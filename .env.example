# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical site URL (used for OG tags / self-links).
# Example: https://diksha-portfolio.vercel.app
APP_URL="MY_APP_URL"
VITE_APP_URL="MY_APP_URL"

# --- Contact form delivery (pick one) ---
# Preferred on Vercel: Resend (https://resend.com)
RESEND_API_KEY=""
CONTACT_TO_EMAIL="dikshaagarwal798@gmail.com"
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Or Formspree (https://formspree.io) — server or client
FORMSPREE_ID=""
VITE_FORMSPREE_ID=""

# Without the above, the form falls back to FormSubmit.co AJAX
# (recipient must confirm the first email FormSubmit sends).
